<?xml version="1.0"?>
<!--
  Panels-mode (rendering) counterpart of ouster_demo.sdf.

  Selected automatically by the example launches when ray_mode:=panels:
    ros2 launch gz_sensors_ouster ouster_standalone.launch.py ray_mode:=panels

  This world loads gz-sim-sensors-system (ogre2), which the plugin's *panels*
  path needs to fire events::Render and run its depth-camera rig. It does NOT
  load gz-sim-altimeter-system — the URDF derives anchor_type:=camera when
  ray_mode==panels, so an altimeter anchor is not present.

  Keep the geometry (ground + obstacles) in sync with ouster_demo.sdf. The only
  difference between the two files is the system set:
    ouster_demo.sdf        → gz-sim-altimeter-system  (raycast, GPU-free, default)
    ouster_demo_panels.sdf → gz-sim-sensors-system    (panels, needs ogre2/GPU)

  Loads:
    * Physics            - steps the sim.
    * Sensors (ogre2)    - spins up the render engine; fires events::Render so
                           the panels plugin path can run its depth-camera rig.
    * SceneBroadcaster   - GUI / state.
    * UserCommands       - lets `ros_gz_sim create` spawn the URDF at runtime.
    * Imu                - populates AngularVelocity/LinearAcceleration on imu
                           sensors; REQUIRED for the plugin's /imu output.

  Ground + a ring of obstacles at varied ranges so the LiDAR returns are
  non-empty.
-->
<sdf version="1.9">
  <world name="ouster_demo_panels">

    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles at increasing range to exercise the depth channels.
         Geometry is byte-identical to ouster_demo.sdf so the two worlds stay
         in sync; the <laser_retro> tags are inert here because panels mode
         derives signal/reflectivity from the GPU depth render, not from
         laser_retro (which only the raycast material model reads). They are
         kept solely to mirror the raycast world. -->
    <model name="box_near">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v">
          <laser_retro>0.8</laser_retro>
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cyl_mid">
      <static>true</static>
      <pose>0 8 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry></collision>
        <visual name="v">
          <laser_retro>0.5</laser_retro>
          <geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry>
          <material><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_far">
      <static>true</static>
      <pose>-12 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 8 3</size></box></geometry></collision>
        <visual name="v">
          <laser_retro>0.5</laser_retro>
          <geometry><box><size>0.4 8 3</size></box></geometry>
          <material><pbr><metal>
            <albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map>
            <metalness>0</metalness><roughness>0.85</roughness>
          </metal></pbr></material></visual>
      </link>
    </model>

    <model name="box_side">
      <static>true</static>
      <pose>3 -6 0.75 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 1.5 1.5</size></box></geometry></collision>
        <visual name="v">
          <laser_retro>0.1</laser_retro>
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
          <material><diffuse>0.8 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Retroreflective sign post: laser_retro > 1 lands in the calibrated
         reflectivity byte's log band (101-255, like traffic signs / retro
         tape). Its calibrated detection probability remains high within the
         active product's representable range. -->
    <model name="retro_sign">
      <static>true</static>
      <pose>-6 6 1.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.05 0.6</size></box></geometry></collision>
        <visual name="v">
          <laser_retro>8.0</laser_retro>
          <geometry><box><size>0.6 0.05 0.6</size></box></geometry>
          <material><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
