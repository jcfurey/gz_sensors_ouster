<?xml version="1.0"?>
<!-- Download-free sewer gallery: connected conduit segments, wet channels,
     masonry response texture, reflective water, and retro maintenance signs. -->
<sdf version="1.9">
  <world name="turtlebot3_sewer">
    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter"/>

    <scene>
      <ambient>0.08 0.1 0.12 1</ambient>
      <background>0.015 0.02 0.025 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="point" name="lamp_west">
      <pose>-8 0 2.7 0 0 0</pose><diffuse>0.9 0.72 0.46 1</diffuse>
      <specular>0.2 0.18 0.14 1</specular><attenuation><range>11</range><constant>0.3</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light type="point" name="lamp_centre">
      <pose>0 0 2.7 0 0 0</pose><diffuse>0.65 0.78 0.82 1</diffuse>
      <specular>0.18 0.2 0.22 1</specular><attenuation><range>11</range><constant>0.3</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light type="point" name="lamp_east">
      <pose>8 0 2.7 0 0 0</pose><diffuse>0.9 0.72 0.46 1</diffuse>
      <specular>0.2 0.18 0.14 1</specular><attenuation><range>11</range><constant>0.3</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <model name="service_walkway">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>30 2.2 0.1</size></box></geometry></collision>
        <visual name="visual"><laser_retro>0.38</laser_retro><geometry><box><size>30 2.2 0.1</size></box></geometry><material><diffuse>0.3 0.31 0.3 1</diffuse><specular>0.06 0.06 0.06 1</specular></material></visual></link>
    </model>
    <model name="floor_west_channel">
      <static>true</static><pose>0 1.85 -0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>30 1.5 0.35</size></box></geometry></collision>
        <visual name="visual"><laser_retro>0.24</laser_retro><geometry><box><size>30 1.5 0.35</size></box></geometry><material><diffuse>0.18 0.2 0.18 1</diffuse></material></visual></link>
    </model>
    <model name="floor_east_channel">
      <static>true</static><pose>0 -1.85 -0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>30 1.5 0.35</size></box></geometry></collision>
        <visual name="visual"><laser_retro>0.24</laser_retro><geometry><box><size>30 1.5 0.35</size></box></geometry><material><diffuse>0.18 0.2 0.18 1</diffuse></material></visual></link>
    </model>

    <!-- Thin, glossy water surfaces sit below the central drive path. -->
    <model name="water_north">
      <static>true</static><pose>0 1.85 0.005 0 0 0</pose>
      <link name="link"><visual name="visual"><laser_retro>0.04</laser_retro><geometry><box><size>29.5 1.25 0.015</size></box></geometry><material><diffuse>0.03 0.11 0.13 0.75</diffuse><specular>0.42 0.42 0.42 1</specular></material><transparency>0.25</transparency></visual></link>
    </model>
    <model name="water_south">
      <static>true</static><pose>0 -1.85 0.005 0 0 0</pose>
      <link name="link"><visual name="visual"><laser_retro>0.04</laser_retro><geometry><box><size>29.5 1.25 0.015</size></box></geometry><material><diffuse>0.03 0.11 0.13 0.75</diffuse><specular>0.42 0.42 0.42 1</specular></material><transparency>0.25</transparency></visual></link>
    </model>

    <!-- Continuous lower walls and inward-leaning shoulders form the conduit.
         Their PBR albedo is paired with the per-pixel Ouster response map. -->
    <model name="masonry_shell">
      <static>true</static>
      <link name="link">
        <collision name="north_wall_c"><pose>0 2.55 0.85 0 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry></collision>
        <visual name="north_wall"><pose>0 2.55 0.85 0 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual>
        <collision name="south_wall_c"><pose>0 -2.55 0.85 0 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry></collision>
        <visual name="south_wall"><pose>0 -2.55 0.85 0 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual>
        <collision name="north_shoulder_c"><pose>0 2.17 2.12 0.58 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry></collision>
        <visual name="north_shoulder"><pose>0 2.17 2.12 0.58 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual>
        <collision name="south_shoulder_c"><pose>0 -2.17 2.12 -0.58 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry></collision>
        <visual name="south_shoulder"><pose>0 -2.17 2.12 -0.58 0 0</pose><geometry><box><size>30 0.25 1.7</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual>
        <collision name="ceiling_c"><pose>0 0 3.18 0 0 0</pose><geometry><box><size>30 2.7 0.22</size></box></geometry></collision>
        <visual name="ceiling"><pose>0 0 3.18 0 0 0</pose><laser_retro>0.31</laser_retro><geometry><box><size>30 2.7 0.22</size></box></geometry><material><diffuse>0.22 0.24 0.22 1</diffuse></material></visual>
        <collision name="end_west_c"><pose>-15 0 1.55 0 0 0</pose><geometry><box><size>0.25 5.2 3.2</size></box></geometry></collision>
        <visual name="end_west"><pose>-15 0 1.55 0 0 0</pose><geometry><box><size>0.25 5.2 3.2</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual>
        <collision name="end_east_c"><pose>15 0 1.55 0 0 0</pose><geometry><box><size>0.25 5.2 3.2</size></box></geometry></collision>
        <visual name="end_east"><pose>15 0 1.55 0 0 0</pose><geometry><box><size>0.25 5.2 3.2</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>../media/materials/textures/brick_graffiti.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual>
      </link>
    </model>

    <!-- Repeated ribs break the gallery into a visible series of conduits. -->
    <model name="conduit_ribs">
      <static>true</static>
      <link name="link">
        <visual name="rib_west_n"><pose>-9 2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_west_s"><pose>-9 -2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_west_top"><pose>-9 0 3.02 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 4.4 0.22</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_mid_n"><pose>-3 2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_mid_s"><pose>-3 -2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_mid_top"><pose>-3 0 3.02 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 4.4 0.22</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_east_n"><pose>3 2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_east_s"><pose>3 -2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_east_top"><pose>3 0 3.02 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 4.4 0.22</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_far_n"><pose>9 2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_far_s"><pose>9 -2.25 1.45 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 0.28 2.9</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
        <visual name="rib_far_top"><pose>9 0 3.02 0 0 0</pose><laser_retro>0.52</laser_retro><geometry><box><size>0.22 4.4 0.22</size></box></geometry><material><diffuse>0.42 0.43 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="maintenance_sign_west"><static>true</static><pose>-11 -2.35 1.2 0 0 0</pose><link name="link"><visual name="visual"><laser_retro>8</laser_retro><geometry><box><size>0.7 0.04 0.5</size></box></geometry><material><diffuse>0.92 0.85 0.18 1</diffuse></material></visual></link></model>
    <model name="maintenance_sign_east"><static>true</static><pose>11 2.35 1.2 0 0 0</pose><link name="link"><visual name="visual"><laser_retro>8</laser_retro><geometry><box><size>0.7 0.04 0.5</size></box></geometry><material><diffuse>0.92 0.85 0.18 1</diffuse></material></visual></link></model>
  </world>
</sdf>
