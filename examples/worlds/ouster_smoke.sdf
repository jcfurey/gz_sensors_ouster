<?xml version="1.0"?>
<!--
  ouster_smoke.sdf - smoke / dust obscuration demo for gz_sensors_ouster.

    ros2 launch gz_sensors_ouster ouster_standalone.launch.py \
      world:=ouster_smoke.sdf

  For this plugin's raycast backend, the Gazebo <particle_emitter> clouds in
  this file are VISUALS ONLY. The
  launch file selects examples/urdf/ouster_smoke_obscurants.xacro, whose 14
  explicit <obscurant> volumes are the authoritative LiDAR physics. Their
  poses line up with the emitters, but their density and shape do not depend
  on billboard rate, lifetime, velocity, particle size or other rendering
  choices. Automatic particle mirroring is off by default.

  See docs/MODEL_REFERENCES.md section 11 for the physics and README.md for
  the knobs. Launching this SDF by another route requires applying the
  smoke_demo obscurant profile to the sensor plugin as well.

  Raycast mode only - obscuration is integrated along each cast beam, and the
  panels pipeline has no equivalent path. Like the other raycast worlds this
  one loads NO rendering system, so it runs headless anywhere.

  Each beam draws a medium return from the range-resolved received-power
  profile beta(r)*exp(-2*tau(r))/R^2. This produces changing, penetrating
  aerosol returns instead of a hard surface at the volume boundary. The
  sampled medium and attenuated target then compete by received power, after
  which ordinary configured range noise still applies.

  Layout: everything sits on azimuth arcs around the sensor at the origin.
  Walls are at 14 m, physical cloud volumes at 7 m. Most are ellipsoids with
  full size 1.8x1.8x3.6 m, so a beam through the middle crosses 1.8 m starting
  at 6.1 m. The nearby particle emitters are merely a visual cue.

  The emitters use a thin ground-level source plane rotated so their
  documented local +X velocity points upward in world +Z. Soft RGBA sprites
  and a lifetime color strip come from OpenRobotics' CC BY 4.0 Fog Generator
  model (see examples/media/particles/README.md). Particle rate is varied with
  the density ladder; it is a rendering control, not the raycast extinction.
  The retained particle_scatter_ratio values only matter to Gazebo's native
  depth and GPU-lidar sensors.

  ZONE A (0-64 deg) - density ladder. The identical walls intentionally omit
    <laser_retro>, exercising the plugin's default <base_reflectivity> of 50
    (physical rho 0.5) before smoke is applied. The companion profile gives
    the explicit volumes rising extinction coefficients:

      sigma 0.05/m -> tau 0.09, wall rho 0.4176, smoke-edge rho 0.0019  => wall
      sigma 0.15/m -> tau 0.27, wall rho 0.2914, smoke-edge rho 0.0057  => wall
      sigma 0.35/m -> tau 0.63, wall rho 0.1418, smoke-edge rho 0.0132  => wall
      sigma 0.65/m -> tau 1.17, wall rho 0.0482, smoke-edge rho 0.0245  => mixed
      sigma 1.00/m -> tau 1.80, wall rho 0.0137, smoke-edge rho 0.0377  => smoke-biased

    The listed smoke rho is the mean leading-edge gate amplitude. Whether a
    plume is detected is photon-limited, and detected ranges are then drawn
    deeper according to the received-power profile. The first three rungs
    mostly preserve the dimming wall, while the last two increasingly report
    sparse smoke returns - the transition a real lidar makes as smoke
    thickens.

  ZONE B (88-142 deg) - explicit physics-shape gallery: box, cylinder and two
    ellipsoids at one density. All visible plumes use the same ground-source
    box emitter; rendering geometry no longer masquerades as participating-
    medium geometry.

  ZONE C (166-206 deg) - smoke against open sky, no wall behind. These beams
    would be misses in clear air; their sparse, scan-varying returns come from
    the medium itself. Empty beams are expected and prevent the explicit
    volume from appearing as a solid phantom obstacle.

  ZONE D (230-262 deg) - NEAR_IR airlight. A 0.05-retro and a 0.95-retro wall
    behind identical clouds, plus an unobscured 0.95 wall for reference. Smoke
    BRIGHTENS the ambient channel toward albedo x illumination (0.8) while it
    DARKENS the laser channels - the signature of fog/smoke on a real Ouster.
    The dark wall disappears completely and the bright one survives: same
    smoke, opposite outcome, because extinction acts on the target's own
    reflectance.

  ZONE E (290-330 deg) - clear-air control walls at three reflectances, for an
    in-frame A/B against the obscured zones.

  Zone spacing is deliberate: a cloud subtends about +/-8 deg from the sensor,
  so the arcs are set far enough apart that each rung obscures ONLY its own
  wall. Move one and the ladder stops measuring what its table says.
-->
<sdf version="1.9">
  <world name="ouster_smoke">

    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-altimeter-system"
            name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <!-- Serves each emitter's .../cmd topic so the visual clouds can be
         toggled and retuned at runtime. The explicit LiDAR volumes are
         intentionally unaffected by those rendering controls. -->
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ZONE A: density ladder (see the header table). The five walls omit
         laser_retro on purpose and therefore use base_reflectivity=50. -->
    <model name="A_wall_005">
      <static>true</static>
      <pose>14.000 0.000 1.50 0 0 0.0000</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 1.80 4.00</size></box></geometry>
          <material>
            <ambient>0.80 0.80 0.80 1</ambient>
            <diffuse>0.80 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="A_smoke_005">
      <static>true</static>
      <pose>7.000 0.000 1.20 0 0 0.0000</pose>
      <link name="link">
        <particle_emitter name="emitter" type="box">
          <emitting>true</emitting>
          <pose>0 0 -1.15 0 -1.5708 0</pose>
          <size>0.08 1.4 1.4</size>
          <particle_size>0.45 0.45 0.01</particle_size>
          <lifetime>6.0</lifetime>
          <min_velocity>0.20</min_velocity>
          <max_velocity>0.35</max_velocity>
          <rate>6</rate>
          <scale_rate>0.12</scale_rate>
          <particle_scatter_ratio>0.05</particle_scatter_ratio>
          <material>
            <diffuse>0.70 0.70 0.70 0.72</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>../media/particles/fog.png</albedo_map>
              </metal>
            </pbr>
          </material>
          <color_range_image>../media/particles/fogcolors.png</color_range_image>
        </particle_emitter>
      </link>
    </model>
    <model name="A_wall_015">
      <static>true</static>
      <pose>13.458 3.859 1.50 0 0 0.2793</pose>
      <link name="link">
